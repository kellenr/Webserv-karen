// Implementation in Utils.cpp
void handleMultipleUploadSimple(const std::string& request, int client_fd, const ServerConfig& config) {
std::cout << "🚀 Starting MULTIPLE file upload process..." << std::endl;

// Use parallel vectors to store file information
std::vector<std::string> filenames;
std::vector<size_t> contentStarts;
std::vector<size_t> contentLengths;

// Step 1: Extract all files from the request
if (!extractAllFilesFromRequestSimple(request, filenames, contentStarts, contentLengths)) {
std::cerr << "❌ No files found in request" << std::endl;
sendHtmlResponse(client_fd, 400, getErrorPageBody(400, config));
return;
}

std::cout << "📁 Found " << filenames.size() << " files to upload" << std::endl;

// Step 2: Validate all files first
for (size_t i = 0; i < filenames.size(); ++i) {
if (!validateUploadFileSize(contentLengths[i], config)) {
std::cerr << "❌ File too large: " << filenames[i] << " (" << contentLengths[i] << " bytes)" << std::endl;
sendHtmlResponse(client_fd, 413, getErrorPageBody(413, config));
return;
}
}

// Step 3: Process each file
std::vector<std::string> successfulUploads;
std::vector<std::string> failedUploads;

for (size_t i = 0; i < filenames.size(); ++i) {
std::cout << "📝 Processing file " << (i + 1) << "/" << filenames.size() << ": " << filenames[i] << std::endl;

std::string filePath = config.root + "/upload/" + filenames[i];

if (writeFileToServer(request, contentStarts[i], contentLengths[i], filePath)) {
std::cout << "✅ Successfully uploaded: " << filenames[i] << std::endl;
successfulUploads.push_back(filenames[i]);
} else {
std::cerr << "❌ Failed to upload: " << filenames[i] << std::endl;
failedUploads.push_back(filenames[i]);
}
}

// Step 4: Send response
if (failedUploads.empty()) {
std::string successResponse = loadAndProcessMultipleSuccessTemplate(config, successfulUploads);
sendHtmlResponse(client_fd, 200, successResponse);
std::cout << "📤 All " << successfulUploads.size() << " files uploaded successfully!" << std::endl;
} else {
std::string errorResponse = generatePartialUploadResponse(config, successfulUploads, failedUploads);
sendHtmlResponse(client_fd, 207, errorResponse); // 207 Multi-Status
std::cout << "⚠️ Partial upload: " << successfulUploads.size() << " success, " << failedUploads.size() << " failed" << std::endl;
}
}

bool extractAllFilesFromRequestSimple(const std::string& request,
	std::vector<std::string>& filenames,
	std::vector<size_t>& contentStarts,
	std::vector<size_t>& contentLengths) {

// Extract boundary from Content-Type header
std::string boundary = extractBoundary(request);
if (boundary.empty()) {
std::cerr << "❌ No boundary found in request" << std::endl;
return false;
}

std::string fullBoundary = "--" + boundary;
std::cout << "🔍 Using boundary: " << fullBoundary << std::endl;

// Find all file parts in the request
size_t searchPos = 0;
while (true) {
// Find next boundary
size_t boundaryPos = request.find(fullBoundary, searchPos);
if (boundaryPos == std::string::npos) break;

// Look for filename in this part
size_t nextBoundaryPos = request.find(fullBoundary, boundaryPos + fullBoundary.length());
if (nextBoundaryPos == std::string::npos) {
nextBoundaryPos = request.length();
}

std::string part = request.substr(boundaryPos, nextBoundaryPos - boundaryPos);

// Check if this part contains a file
size_t filenamePos = part.find("filename=\"");
if (filenamePos != std::string::npos) {
// Extract filename
size_t filenameStart = filenamePos + 10; // Length of "filename=\""
size_t filenameEnd = part.find("\"", filenameStart);
if (filenameEnd != std::string::npos) {
std::string filename = part.substr(filenameStart, filenameEnd - filenameStart);

if (!filename.empty() && filename != "\"\"") {
// Find content start (after double CRLF)
size_t contentStartMarker = part.find("\r\n\r\n");
if (contentStartMarker != std::string::npos) {
size_t contentStart = boundaryPos + contentStartMarker + 4;

// Find content end (before next boundary or end)
size_t contentEnd = nextBoundaryPos;
// Adjust for CRLF before boundary
if (contentEnd >= 2 &&
request[contentEnd - 1] == '\n' &&
request[contentEnd - 2] == '\r') {
contentEnd -= 2;
}

size_t contentLength = contentEnd - contentStart;

if (contentLength > 0) {
// Add to our parallel vectors
filenames.push_back(filename);
contentStarts.push_back(contentStart);
contentLengths.push_back(contentLength);

std::cout << "📄 Found file: " << filename
	 << " (size: " << contentLength << " bytes)" << std::endl;
}
}
}
}
}

searchPos = nextBoundaryPos;
}

return !filenames.empty();
}